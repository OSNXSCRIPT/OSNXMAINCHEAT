local function RF_setInfiniteAmmo()
    local tool = RF_getTool(); if not tool then return end
    for _, obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("IntValue") or obj:IsA("NumberValue") then
            local n = obj.Name:lower()
            if n:find("ammo") or n:find("bullet") or n:find("mag") or n:find("clip")
            or n:find("count") or n:find("loaded") or n:find("reserve") or n:find("stock") then
                obj.Value = math.huge
            end
        end
        for attrName in pairs(obj:GetAttributes()) do
            local ln = attrName:lower()
            if ln:find("ammo") or ln:find("bullet") or ln:find("mag")
            or ln:find("clip") or ln:find("count") or ln:find("loaded") then
                pcall(function() obj:SetAttribute(attrName, math.huge) end)
            end
        end
    end
    for attrName in pairs(tool:GetAttributes()) do
        local ln = attrName:lower()
        if ln:find("ammo") or ln:find("bullet") or ln:find("mag")
        or ln:find("clip") or ln:find("count") or ln:find("loaded") then
            pcall(function() tool:SetAttribute(attrName, math.huge) end)
        end
    end
    if tool:GetAttribute("rateOfFire") ~= nil then
        tool:SetAttribute("rateOfFire", RF.RateOfFire)
    end
end

local function RF_applyNoRecoil()
    local tool = RF_getTool(); if not tool then return end
    for _, obj in ipairs(tool:GetDescendants()) do
        if (obj:IsA("IntValue") or obj:IsA("NumberValue")) and RF.NoRecoil then
            local n = obj.Name:lower()
            if n:find("recoil") or n:find("kick") then obj.Value = 0 end
        end
    end
end

local function RF_disableReload()
    local tool = RF_getTool(); if not tool then return end
    for _, obj in ipairs(tool:GetDescendants()) do
        local n = obj.Name:lower()
        if n == "reload" or n == "reloadtime" then
            if obj:IsA("BoolValue") then obj.Value = false
            elseif obj:IsA("NumberValue") or obj:IsA("IntValue") then obj.Value = 0 end
        end
    end
end

local function RF_isTeammate(plr)
    if not RF.IgnoreTeam then return false end
    if not plr.Team or not LP.Team then return false end
    return plr.Team == LP.Team
end

local function RF_getClosestTarget(fovRadius)
    local closest = nil
    local shortest = fovRadius or RF.FOVRadius
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if RF_isTeammate(plr) then continue end
        local char = plr.Character; if not char then continue end
        local head = char:FindFirstChild("Head")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not head or not hum or hum.Health <= 0 then continue end
        local sp, on = Camera:WorldToViewportPoint(head.Position); if not on then continue end
        local dist = (center - Vector2.new(sp.X, sp.Y)).Magnitude
        if dist < shortest then shortest = dist; closest = head end
    end
    return closest
end

local function RF_fire()
    if not Shoot then return end
    local now = tick(); if now - RF_lastFire < RF.FireDelay then return end
    RF_lastFire = now
    local tool = RF_getTool(); if not tool or tool.Parent ~= LP.Character then return end
    local origin = Camera.CFrame.Position
    local aimPos
    if RF.AutoAim or RF.SuperLock then
        local t = RF_getClosestTarget(RF.SuperLock and RF.SuperLockFOV or RF.FOVRadius)
        if t then
            aimPos = t.Position
            local vel; pcall(function() vel = t.Velocity end)
            if vel then aimPos = aimPos + vel * RF.PredictionAmount end
        else aimPos = Camera.CFrame.LookVector * 1000 + origin end
    else aimPos = Camera.CFrame.LookVector * 1000 + origin end
    local dir = (aimPos - origin).Unit
    local cf  = CFrame.new(origin, origin + dir)
    pcall(function() Shoot:FireServer(tick(), tool, cf, {}) end)
    pcall(function() tool:Activate() end)
end

local function RF_spreadFire()
    if not Shoot then return end
    local now = tick(); if now - RF_lastFire < RF.FireDelay then return end
    RF_lastFire = now
    local tool = RF_getTool(); if not tool or tool.Parent ~= LP.Character then return end
    local origin = Camera.CFrame.Position
    local base   = Camera.CFrame.LookVector
    for i = 1, RF.SpreadBulletCount do
        local sr = math.rad(RF.SpreadBulletAmount)
        local rx = (math.random()-0.5)*2*sr
        local ry = (math.random()-0.5)*2*sr
        local rot = CFrame.new(Vector3.zero, base) * CFrame.Angles(rx, ry, 0)
        local cf  = CFrame.new(origin, origin + rot.LookVector)
        pcall(function() Shoot:FireServer(tick(), tool, cf, {}) end)
    end
    pcall(function() tool:Activate() end)
end

local function RF_magicFire()
    if not Shoot then return end
    local now = tick(); if now - RF_lastFire < RF.FireDelay then return end
    RF_lastFire = now
    local tool = RF_getTool(); if not tool or tool.Parent ~= LP.Character then return end
    local origin = Camera.CFrame.Position
    local fired  = false
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP or RF_isTeammate(plr) then continue end
        local char = plr.Character; if not char then continue end
        local head = char:FindFirstChild("Head")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not head or not hum or hum.Health <= 0 then continue end
        local aimPos = head.Position
        local vel; pcall(function() vel = head.Velocity end)
        if vel then aimPos = aimPos + vel * RF.PredictionAmount end
        local dir = (aimPos - origin).Unit
        pcall(function() Shoot:FireServer(tick(), tool, CFrame.new(origin, origin+dir), {}) end)
        fired = true
    end
    if not fired then
        pcall(function() Shoot:FireServer(tick(), tool, CFrame.new(origin, origin+Camera.CFrame.LookVector), {}) end)
    end
    pcall(function() tool:Activate() end)
end

local function RF_oneTapFire()
    if not Shoot then return end
    local now = tick(); if now - RF_lastFire < RF.FireDelay then return end
    RF_lastFire = now
    local tool = RF_getTool(); if not tool or tool.Parent ~= LP.Character then return end
    local origin = Camera.CFrame.Position
    local targets = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP or RF_isTeammate(plr) then continue end
        local char = plr.Character; if not char then continue end
        local head = char:FindFirstChild("Head")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not head or not hum or hum.Health <= 0 then continue end
        table.insert(targets, head)
    end
    if #targets == 0 then return end
    for _, t in ipairs(targets) do
        local aimPos = t.Position
        local vel; pcall(function() vel = t.Velocity end)
        if vel then aimPos = aimPos + vel * RF.PredictionAmount end
        local dir = (aimPos - origin).Unit
        pcall(function() Shoot:FireServer(tick(), tool, CFrame.new(origin, origin+dir), {}) end)
    end
    pcall(function() tool:Activate() end)
end

local function RF_runCycle()
    if not RF_shouldFire() then return end
    if RF_oneTapKill or RF.OneTapKill then RF_oneTapFire()
    elseif RF.MagicBullet then RF_magicFire()
    elseif RF.SpreadBullets then RF_spreadFire()
    else RF_fire() end
end

